#!/bin/sh
# Opportunistic secret scan. gitleaks is NOT a prerequisite for contributing:
# the authoritative scan runs in CI, over full history, on every pull request.
# When the tool happens to be installed locally it catches a mistake seconds
# earlier, which is worth having and not worth nagging about.

command -v gitleaks >/dev/null 2>&1 || exit 0

if ! gitleaks protect --staged --redact --no-banner; then
    printf 'pre-commit: gitleaks found a candidate secret in the staged diff.\n' >&2
    printf '  Treat it as compromised: rotate it, do not just unstage it.\n' >&2
    exit 1
fi

exit 0
