# ---------------------------------------------------------------------------
# Balaaca - local development environment
#
# Copy to .env and adjust. NEVER commit .env: it is in .gitignore and these
# values are deliberately weak so that a leak costs nothing. Production secrets
# come from the host's secret store, never from a file in the repository.
# ---------------------------------------------------------------------------

COMPOSE_PROJECT_NAME=balaaca

# Role NAMES are fixed - the migrations grant to them literally - so only the
# passwords are set here.
# --- PostgreSQL -------------------------------------------------------------
# The superuser exists only to bootstrap. The application never uses it: it
# connects as balaaca_app, which holds neither BYPASSRLS nor table ownership,
# so Row-Level Security actually applies to it.
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
# Host-side port. Deliberately not 5432: a developer machine usually already
# runs PostgreSQL there, and the collision is silent until compose fails.
POSTGRES_HOST_PORT=55432
POSTGRES_DB=balaaca
POSTGRES_SUPERUSER=postgres
POSTGRES_SUPERUSER_PASSWORD=change-me-locally

# Application role - subject to RLS, owns nothing.
BALAACA_DB_APP_PASSWORD=change-me-locally

# Migration role - owns the schema, runs Flyway. Never used at runtime.
BALAACA_DB_MIGRATOR_PASSWORD=change-me-locally

# Notification worker - restricted to the notifications table.
BALAACA_DB_WORKER_PASSWORD=change-me-locally

# --- Redis ------------------------------------------------------------------
# Cache, rate limiting and idempotency records only. Never the source of truth,
# and never a lock for slot exclusion.
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_HOST_PORT=56379
REDIS_PASSWORD=change-me-locally

# --- Keycloak ---------------------------------------------------------------
# The only identity provider. No password, hash or reset token is ever stored
# by the application.
KEYCLOAK_PORT=8180
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=change-me-locally
KEYCLOAK_DB=keycloak
KEYCLOAK_DB_USER=keycloak
KEYCLOAK_DB_PASSWORD=change-me-locally
KEYCLOAK_REALM=balaaca
# Where a browser reaches Keycloak. It is also what writes the addresses into
# the messages, which have no request behind them to work one out from: without
# it a confirmation link points at the container's internal port and opens
# nowhere.
KEYCLOAK_PUBLIC_URL=http://localhost:8180
KEYCLOAK_ISSUER_URL=http://localhost:8180/realms/balaaca

# Backend client - bearer-only, validates tokens.
KEYCLOAK_BACKEND_CLIENT_ID=balaaca-backend
# Frontend client - authorization code + PKCE, driven by the Next.js BFF.
KEYCLOAK_FRONTEND_CLIENT_ID=balaaca-frontend
# Generated by Keycloak when the realm is imported, so it is not in the realm
# file and cannot be: a secret in a committed file is a secret. Read it once
# from the admin console, Clients > balaaca-frontend > Credentials.
KEYCLOAK_FRONTEND_CLIENT_SECRET=change-me-locally

# --- Application ------------------------------------------------------------
BACKEND_PORT=8080
FRONTEND_PORT=3000
APP_PUBLIC_ORIGIN=http://localhost:3000

# Where the BFF reaches the API. Server-side only: the browser never addresses
# the backend at all, so this is a container-network address in production and
# is deliberately not the origin above.
BALAACA_API_BASE_URL=http://localhost:8080

# Seals the session cookie the BFF sets - AES-256-GCM, so the access token
# inside it is unreadable by the browser that carries it. Rotating this signs
# everybody out, which is the correct behaviour and the reason it is not
# derived from anything else.
#
#   openssl rand -base64 48
BALAACA_SESSION_SECRET=change-me-locally
APP_DEFAULT_TIMEZONE=Africa/Conakry
APP_DEFAULT_CURRENCY=GNF
APP_DEFAULT_LOCALE=fr

# --- Notification channels --------------------------------------------------
# Left empty in development: the worker falls back to a logging channel that
# writes the message instead of sending it. Nothing is delivered by accident.
NOTIFICATION_CHANNEL_ORDER=WHATSAPP,SMS,EMAIL
WHATSAPP_API_URL=
WHATSAPP_API_TOKEN=
SMS_API_URL=
SMS_API_TOKEN=
EMAIL_API_URL=
EMAIL_API_KEY=

# --- WhatsApp ---------------------------------------------------------------
# The only programmatic way to send a WhatsApp is the Business Platform: the
# consumer app has no API, and the libraries that drive whatsapp-web violate the
# terms and get the number banned.
#
# Unset here on purpose. The worker only demands them when it is pointed at
# WhatsApp, so the stack runs without an account - point BASE_URL at a stub that
# speaks the same protocol and the whole path works end to end.
WHATSAPP_BASE_URL=https://graph.facebook.com
WHATSAPP_API_VERSION=v21.0
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=

# --- Media ------------------------------------------------------------------
# Ou vivent les images publiees. A sauvegarder separement : le repertoire ne
# fait pas partie du dump PostgreSQL, et une base restauree sans lui pointe vers
# des images absentes.
BALAACA_MEDIA_ROOT=/var/lib/balaaca/media

# --- What Keycloak sends ------------------------------------------------------
# Keycloak posts its own messages, over SMTP. It cannot drive an HTTP API, so
# EMAIL_API_URL above is no use to it whatsoever.
#
# Left empty, these point at the mailpit service in docker-compose: everything
# lands in a web inbox at http://localhost:8025 and nothing leaves this machine.
# That is what makes the confirmation flow something you can exercise today
# rather than something you take on trust.
#
# Production replaces them with a real relay. With no user and no password
# Keycloak announces no authentication at all - deliberately: an empty user is
# read as a user, and a relay then refuses credentials nobody meant to send.
KEYCLOAK_SMTP_HOST=
KEYCLOAK_SMTP_PORT=
KEYCLOAK_SMTP_FROM=
KEYCLOAK_SMTP_FROM_DISPLAY=
KEYCLOAK_SMTP_USER=
KEYCLOAK_SMTP_PASSWORD=
KEYCLOAK_SMTP_STARTTLS=

# The catcher's web inbox. Development only.
MAILPIT_WEB_PORT=8025
